# ── Axis 2: effects on the type, integrated with dependent types ─────────
# Two obligations:
#   (1) `log` performs IO, but its signature hides it -> effect leak.
#   (2) `fetch` asks http_get for 5 retries, but the `Net` effect's safety
#       property caps retries at 3. That cap is a *refinement* on the
#       operation's argument, so the very same solver flags it.

fn log(msg: Int) -> Int {
  print(msg);
  msg
}

fn fetch() -> Int ! {Net} {
  http_get(5)
}

fn main() -> Int ! {IO, Net} {
  log(1);
  fetch()
}
